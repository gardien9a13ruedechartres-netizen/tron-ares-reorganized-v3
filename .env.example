# Branche GitHub à pousser.
GIT_BRANCH=main

# Message de commit automatique.
COMMIT_PREFIX=auto deploy

# Délai anti-spam en millisecondes après une modification.
DEBOUNCE_MS=2500

# true = ouvre un nouveau terminal/shell pour exécuter le déploiement.
# false = exécute le déploiement dans le terminal actuel.
OPEN_NEW_SHELL=true

# Dossiers/fichiers ignorés par la surveillance.
IGNORE_PATTERNS=node_modules,.git,dist,build,.next,.nuxt,.wrangler,.cache

# git = commit + push GitHub, puis Cloudflare Pages déploie automatiquement.
# cloudflare = lance directement la commande Cloudflare.
DEPLOY_MODE=git

# Commande utilisée seulement si DEPLOY_MODE=cloudflare.
CLOUDFLARE_COMMAND=npm run deploy

# Vérification forcée des changements fichiers.
POLLING_INTERVAL_MS=1000

# Vérification Git régulière.
GIT_CHECK_INTERVAL_MS=30000
